# For scripts/setup.mjs, scripts/check-sync.mjs and scripts/dev-server.mjs ONLY (never for the app). Copy to .env (gitignored).
#
# Back4app: APP_ID / REST_KEY / MASTER_KEY from App Settings → Security & Keys, SERVER_URL=https://parseapi.back4app.com
# Local dev server (npm run dev:server): any random strings work as keys; CLIENT_KEY is what the app's
# backend.properties uses; SERVER_URL must be a localhost URL (the emulator reaches it as http://10.0.2.2:1339/).
APP_ID=
CLIENT_KEY=
REST_KEY=
MASTER_KEY=
SERVER_URL=https://parseapi.back4app.com
# local dev server only:
#DATABASE_URL=postgres://localhost:5433/expense_dev
#PARSE_PORT=1339
